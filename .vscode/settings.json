
{
    "logFileHighlighter.customPatterns": [
        {
            "pattern": "in\\s+([a-zA-Z0-9_:]+)\\s*\\(",
            "foreground": "#FFD700", // 金色高亮函数名
            "fontWeight": "bold"
        },
        {
            // 匹配规则：
            // 1. (?<=/) : 前面必须是一个斜杠 "/" (后顾断言，确保是路径的结尾部分)
            // 2. [^/:\s]+ : 匹配文件名 (不包含斜杠、冒号或空格的字符序列)
            // 3. :\d+     : 匹配冒号和行号
            // 4. (?=\s|\)|$) : 后面必须跟空格、右括号或行尾 (先行断言)
            "pattern": "(?<=/)[^/:\\s]+:\\d+(?=\\s|\\)|$)",
            "foreground": "#4EC9B0", // 青色高亮文件名:行号
            "fontWeight": "bold"
        },
        {
            // 匹配规则：
            // 1. (?<=::|\s|^) : 前面必须是 "::" 或者 "空格" 或者 "行首" (后顾断言，不计入匹配)
            // 2. ([a-zA-Z0-9_~]+) : 匹配函数名 (包括析构函数的 ~)
            // 3. (?=\s*\()      : 后面必须紧跟 "("，允许中间有空格 (先行断言，不计入匹配)
            "pattern": "(?<=::|\\s|^)([a-zA-Z0-9_~]+)(?=\\s*\\()",
            "foreground": "#87CEFA",
            "fontWeight": "bold"
        },
        {
            "pattern": "0x[0-9a-fA-F]+",
            "foreground": "#D4D4D4"
        }
    ]
}